## 🎯 Usage Example

### **Page Object with Cache Integration**

```typescript
import { Page } from '@playwright/test';
import { AIElement } from 'Engine/Shared/AIElement';
import { AIPage } from 'Engine/Shared/AIPage';

export class LoginPage extends AIPage {
    private usernameInput: AIElement;
    private passwordInput: AIElement;
    private loginButton: AIElement;

    constructor(page: Page) {
        // Page identifier for cache lookup
        super(page, 'LoginPage');
        
        // AIElement instances with cache keys matching locator_cache.json
        // Description parameter uses extended natural language to clearly identify element
        this.usernameInput = new AIElement(this, 'usernameInput', 'Username input field in the login form at the top');
        this.passwordInput = new AIElement(this, 'passwordInput', 'Password input field in the login form below username');
        this.loginButton = new AIElement(this, 'loginButton', 'Login submit button at the bottom of the login form');
    }

    async login(username: string, password: string): Promise<void> {
        // AIElement automatically:
        // 1. Looks up LoginPage.locators.usernameInput in cache
        // 2. Gets locator: "input[name='username']"
        // 3. Uses locator with Playwright API
        // 4. Falls back to AI if cache miss (optional)
        await this.usernameInput.fill(username);
        
        await this.passwordInput.fill(password);
        await this.loginButton.click();
    }
}
```

### **Corresponding Cache Entry**

```json
{
  "LoginPage": {
    "name": "Login Page",
    "url": "/login",
    "description": "User authentication page",
    "locators": {
      "usernameInput": {
        "key": "usernameInput",
        "description": "Username input field",
        "locator": "input[name='username']"
      },
      "passwordInput": {
        "key": "passwordInput",
        "description": "Password input field",
        "locator": "input[name='password']"
      },
      "loginButton": {
        "key": "loginButton",
        "description": "Login button",
        "locator": "button:has-text('Log In')"
      }
    }
  }
}
```

