- **(MANDATORY)** Business classes are independent - NO cross-business calls

**Business Flow Tags**:
- If test description contains tags `[[BS123 START]]...[[BS123 FINISH]]`, create separate Business Workflow class
- Use tag identifier in class name: `BS123_UserRegistrationFlow`
- Each business flow handles only steps within its tag boundaries

**Example Pattern**:
```typescript
import { Page } from '@playwright/test';
import { AIPage } from 'Engine/Shared/AIPage';
import { TestLogger } from 'Engine/Shared/TestLogger';
import { DashboardPage } from 'tests/Functional/DashboardPage';

export class DashboardNavigationWorkflow extends AIPage {
    private dashboardPage: DashboardPage;

    constructor(page: Page) {
        super(page);
        this.dashboardPage = new DashboardPage(page);
    }

    async navigateAndOpenMenu(baseUrl: string): Promise<void> {
        await TestLogger.businessStep('Navigate to dashboard and open menu', async () => {
            await this.dashboardPage.navigateToDashboard(baseUrl);
            await this.dashboardPage.clickMenu();
            TestLogger.info('Dashboard menu accessed');
        });
    }
}

export default DashboardNavigationWorkflow;
```

