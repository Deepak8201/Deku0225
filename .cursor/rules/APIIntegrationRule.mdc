## 🔧 Usage Patterns

### **Pattern 1: API Setup Workflow**

**Business Workflow**: `test/Business/TestDataSetupWorkflow.ts`

```typescript
import { Page } from '@playwright/test';
import { AIPage } from 'Engine/Shared/AIPage';
import { APIHelper } from 'Engine/Shared/APIHelper';
import { TestLogger } from 'Engine/Shared/TestLogger';

export class TestDataSetupWorkflow extends AIPage {
    private apiHelper: APIHelper;

    constructor(page: Page) {
        super(page, 'TestDataSetupWorkflow');
        this.apiHelper = new APIHelper();
    }

    /**
     * Initialize API helper and authenticate
     * @param authSystemName - System name for OAuth
     */
    async initialize(authSystemName: string): Promise<void> {
        await TestLogger.businessStep('Initialize API for test data setup', async () => {
            await this.apiHelper.initialize();
            
            const authConfig = SettingsHelper.getOAuthConfig(authSystemName);
            
            await this.apiHelper.getOAuthToken(
                authConfig.tokenEndpoint,
                authConfig.clientId,
                authConfig.clientSecret,
                authConfig.scope
            );
            TestLogger.info('✓ API initialized for test data setup');
        });
    }

    async createTestUser(apiSystemName: string, userData: UserData): Promise<string> {
        return await TestLogger.businessStep('Create test user via API', async () => {
            
            const apiConfig = SettingsHelper.getAPIConfiguration(apiSystemName);
            
            const user = await this.apiHelper.post(`${apiConfig.url}/users`, userData);
            TestLogger.info(`✓ Test user created: ${user.id}`);
            return user.id;
        });
    }

    async deleteTestUser(apiSystemName: string, userId: string): Promise<void> {
        await TestLogger.businessStep(`Delete test user: ${userId}`, async () => {
            
            const apiConfig = SettingsHelper.getAPIConfiguration(apiSystemName);
            
            await this.apiHelper.delete(`${apiConfig.url}/users/${userId}`);
            TestLogger.info(`✓ Test user deleted: ${userId}`);
        });
    }

    async cleanup(): Promise<void> {
        await TestLogger.businessStep('Cleanup API resources', async () => {
            await this.apiHelper.dispose();
            TestLogger.info('✓ API resources cleaned up');
        });
    }
}
```

**Test Scenario**: `test/TestScenario/UserManagementTest.test.ts`

```typescript
import { test } from '@playwright/test';
import { TestLogger } from 'Engine/Shared/TestLogger';
import { SettingsHelper } from 'Engine/Shared/SettingsHelper';
import { TestDataSetupWorkflow } from 'test/Business/TestDataSetupWorkflow';
import { UserManagementWorkflow } from 'test/Business/UserManagementWorkflow';

test('User management with API setup', async ({ page }) => {
    TestLogger.reset();

    const setupWorkflow = new TestDataSetupWorkflow(page);
    const userWorkflow = new UserManagementWorkflow(page);

    let userId: string;

    // ===== SETUP via Business Workflow =====
    await TestLogger.testStep('Setup: Create test user via API', async () => {
        await setupWorkflow.initialize('auth-gateway');
        
        userId = await setupWorkflow.createTestUser('user-api', {
            username: `testuser_${Date.now()}`,
            email: `test@example.com`
        });
    });

    // ===== EXECUTION: UI Testing =====
    await TestLogger.testStep('Verify user in UI', async () => {
        await userWorkflow.navigateToUserManagement();
        await userWorkflow.searchAndVerifyUser(userId);
    });

    // ===== CLEANUP via Business Workflow =====
    await TestLogger.testStep('Cleanup: Delete test user', async () => {
        await setupWorkflow.deleteTestUser('user-api', userId);
        await setupWorkflow.cleanup();
    });
});
```

### **Pattern 2: GraphQL Data Verification Workflow**

**Business Workflow**: `test/Business/DataVerificationWorkflow.ts`

```typescript
import { Page } from '@playwright/test';
import { AIPage } from 'Engine/Shared/AIPage';
import { APIHelper } from 'Engine/Shared/APIHelper';
import { TestLogger } from 'Engine/Shared/TestLogger';

export class DataVerificationWorkflow extends AIPage {
    private apiHelper: APIHelper;

    constructor(page: Page) {
        super(page, 'DataVerificationWorkflow');
        this.apiHelper = new APIHelper();
    }

    /**
     * Initialize API helper and authenticate
     * @param authSystemName - System name for OAuth (e.g., 'auth-gateway')
     */
    async initialize(authSystemName: string): Promise<void> {
        await TestLogger.businessStep('Initialize API for data verification', async () => {
            await this.apiHelper.initialize();
            
            const authConfig = SettingsHelper.getOAuthConfig(authSystemName);
            
            await this.apiHelper.getOAuthToken(
                authConfig.tokenEndpoint,
                authConfig.clientId,
                authConfig.clientSecret,
                authConfig.scope
            );
        });
    }

    async verifyCustomerData(apiSystemName: string, customerId: string): Promise<CustomerData> {
        return await TestLogger.businessStep(`Verify customer data via API: ${customerId}`, async () => {

            const apiConfig = SettingsHelper.getAPIConfiguration(apiSystemName);
            
            const graphqlEndpoint = `${apiConfig.url}/graphql`;
            
            const query = `
                query GetCustomer($id: ID!) {
                    customer(id: $id) {
                        id
                        name
                        status
                        createdAt
                    }
                }
            `;

            const response = await this.apiHelper.executeGraphQLQuery(
                graphqlEndpoint,
                query,
                { id: customerId }
            );

            if (response.errors) {
                throw new Error(`Failed to fetch customer: ${JSON.stringify(response.errors)}`);
            }

            TestLogger.info(`✓ Customer verified: ${response.data.customer.name}`);
            return response.data.customer;
        });
    }

    async cleanup(): Promise<void> {
        await TestLogger.businessStep('Cleanup verification resources', async () => {
            await this.apiHelper.dispose();
        });
    }
}
```

