## ✅ CORRECT Architecture Example

### **1. Business Workflow with API Operations**
**File**: `test/Business/CustomerCategoryWorkflow.ts`

```typescript
import { Page } from '@playwright/test';
import { AIPage } from 'Engine/Shared/AIPage';
import { APIHelper } from 'Engine/Shared/APIHelper';
import { TestLogger } from 'Engine/Shared/TestLogger';

/**
 * Customer Category Workflow
 * 
 * Encapsulates all API operations for customer categories.
 * Test scenarios call methods from this class - NOT APIHelper directly.
 */
export class CustomerCategoryWorkflow extends AIPage {
    private apiHelper: APIHelper;
    private isInitialized: boolean = false;

    constructor(page: Page) {
        super(page, 'CustomerCategoryWorkflow');
        this.apiHelper = new APIHelper();
    }

    /**
     * Initialize API helper and authenticate
     * @param authSystemName - System name for OAuth authentication
     */
    async initialize(authSystemName: string): Promise<void> {
        await TestLogger.businessStep('Initialize API and authenticate', async () => {
            
            await this.apiHelper.initialize();

            const authConfig = SettingsHelper.getOAuthConfig(authSystemName);
            
            await this.apiHelper.getOAuthToken(
                authConfig.tokenEndpoint, 
                authConfig.clientId,
                authConfig.clientSecret,
                authConfig.scope
            );
            this.isInitialized = true;
            TestLogger.info('✓ API initialized and authenticated');
        });
    }

    /**
     * Fetch customer categories via GraphQL
     * @param apiSystemName - System name for API endpoint
     */
    async fetchCustomerCategories(apiSystemName: string): Promise<any[]> {
        return await TestLogger.businessStep('Fetch customer categories via API', async () => {
            this.ensureInitialized();
            
            const apiConfig = SettingsHelper.getAPIConfiguration(apiSystemName);

            const graphqlEndpoint = `${apiConfig.url}/graphql`;
            
            const query = `
                query listCustomerCategories {
                    listCustomerCategories {
                        id
                        name
                        originalName
                        code
                    }
                }
            `;
            
            const response = await this.apiHelper.executeGraphQLQuery(graphqlEndpoint, query);
            
            if (response.errors) {
                TestLogger.error('GraphQL query returned errors');
                throw new Error(`GraphQL errors: ${JSON.stringify(response.errors)}`);
            }
            
            const categories = response.data?.listCustomerCategories || [];
            TestLogger.info(`✓ Fetched ${categories.length} customer categories`);
            
            return categories;
        });
    }

    /**
     * Create customer via REST API
     * @param apiSystemName - System name for API endpoint
     */
    async createCustomer(apiSystemName: string, customerData: any): Promise<string> {
        return await TestLogger.businessStep('Create customer via API', async () => {
            this.ensureInitialized();
            
            const apiConfig = SettingsHelper.getAPIConfiguration(apiSystemName);

            const createEndpoint = `${apiConfig.url}/customers`;
            const response = await this.apiHelper.post(createEndpoint, customerData);
            TestLogger.info(`✓ Customer created: ${response.id}`);
            
            return response.id;
        });
    }

    /**
     * Delete customer via REST API
     * @param apiSystemName - System name for API endpoint
     */
    async deleteCustomer(apiSystemName: string, customerId: string): Promise<void> {
        await TestLogger.businessStep(`Delete customer: ${customerId}`, async () => {
            this.ensureInitialized();
            
            const apiConfig = SettingsHelper.getAPIConfiguration(apiSystemName);

            const deleteEndpoint = `${apiConfig.url}/customers/${customerId}`;
            await this.apiHelper.delete(deleteEndpoint);
            TestLogger.info(`✓ Customer deleted: ${customerId}`);
        });
    }

    /**
     * Cleanup - dispose API helper
     */
    async cleanup(): Promise<void> {
        await TestLogger.businessStep('Cleanup API resources', async () => {
            await this.apiHelper.dispose();
            this.isInitialized = false;
            TestLogger.info('✓ API resources cleaned up');
        });
    }

    private ensureInitialized(): void {
        if (!this.isInitialized) {
            throw new Error('API not initialized. Call initialize() first.');
        }
    }
}

export default CustomerCategoryWorkflow;
```

### **2. Test Scenario Using Business Workflow**
**File**: `test/TestScenario/CustomerCategoryTest.test.ts`

```typescript
import { test } from '@playwright/test';
import { TestLogger } from 'Engine/Shared/TestLogger';
import { SettingsHelper } from 'Engine/Shared/SettingsHelper';
import { CustomerCategoryWorkflow } from 'test/Business/CustomerCategoryWorkflow';
import { LoginWorkflow } from 'test/Business/LoginWorkflow';

/**
 * Customer Category Test
 * 
 * NOTE: This test uses Business Workflow methods - NOT APIHelper directly.
 * All API operations are encapsulated in CustomerCategoryWorkflow.
 */
test('Verify customer categories from API and navigate to portal', async ({ page }) => {
    TestLogger.reset();

    // Get configuration from settings
    const baseUrl = SettingsHelper.getBaseUrl('systemName');
    const credentials = SettingsHelper.getDefaultCredentials('systemName');

    // Initialize workflows
    const categoryWorkflow = new CustomerCategoryWorkflow(page);
    const loginWorkflow = new LoginWorkflow(page);

    let categories: any[];

    // ===== SETUP PHASE: API Operations via Business Workflow =====
    await TestLogger.testStep('Initialize API and authenticate', async () => {
        // ✅ CORRECT: Call Business Workflow method with system name
        await categoryWorkflow.initialize('systemName');
    });

    await TestLogger.testStep('Fetch customer categories via API', async () => {
        // ✅ CORRECT: Call Business Workflow method
        categories = await categoryWorkflow.fetchCustomerCategories('systemName');
        TestLogger.info(`Retrieved ${categories.length} categories`);
    });

    // ===== EXECUTION PHASE: UI Testing =====
    await TestLogger.testStep('Login to application', async () => {
        await loginWorkflow.performLogin(baseUrl, credentials.username, credentials.password);
    });

    await TestLogger.testStep('Verify categories in UI', async () => {
        // UI verification using category data from API
        for (const category of categories) {
            TestLogger.info(`Verifying category: ${category.name}`);
            // ... UI verification logic
        }
    });

    // ===== CLEANUP PHASE =====
    await TestLogger.testStep('Cleanup API resources', async () => {
        // ✅ CORRECT: Call Business Workflow method
        await categoryWorkflow.cleanup();
    });
});
```

