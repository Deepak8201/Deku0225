    await this.loginButton.click();
}

// Step 2: RECONSTRUCT - Original method unchanged (calls smaller interactions)
async fillLoginForm(username: string, password: string): Promise<void> {
    await TestLogger.pageStep('Fill login credentials', async () => {
        await this.fillUsername(username);
        await this.fillPassword(password);
    });
}

// Step 3: MERGE - New method composes smaller interactions + new functionality
async fillLoginFormWithRememberMe(username: string, password: string): Promise<void> {
    await TestLogger.pageStep('Fill login credentials with Remember Me', async () => {
        await this.fillUsername(username);
        await this.fillPassword(password);
