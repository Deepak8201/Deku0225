## 🚫 Prohibited Patterns

### **❌ Direct Locator Access in High-Level Code**

```typescript
// ❌ WRONG - Test Scenario with direct locators
test('User login', async ({ page }) => {
  await page.click('#loginButton');  // ❌ Direct locator
  await page.fill('#username', 'user');  // ❌ Direct interaction
});

// ✅ CORRECT - Test Scenario calls Business layer
test('User login', async ({ page }) => {
  await TestLogger.testStep('Login to application', async () => {
    await loginWorkflow.performLogin(baseUrl, username, password);
  });
});
```

### **❌ Direct Page Interactions in Business Layer**

```typescript
// ❌ WRONG - Business with direct page interactions
export class LoginWorkflow extends AIPage {
  async performLogin(username: string, password: string): Promise<void> {
    await this.page.fill('#username', username);  // ❌ Direct interaction
    await this.page.click('#loginBtn');  // ❌ Direct locator
  }
}

// ✅ CORRECT - Business calls Page Object methods
export class LoginWorkflow extends AIPage {
  private loginPage: LoginPage;
  
  constructor(page: Page) {
    super(page);
    this.loginPage = new LoginPage(page);
  }
  
  async performLogin(username: string, password: string): Promise<void> {
    await TestLogger.businessStep(`Login with username: ${username}`, async () => {
      await this.loginPage.login(username, password);
    });
  }
}
```

### **❌ Direct Locators in Page Objects**

```typescript
// ❌ WRONG - Page Object with direct locators
export class LoginPage extends AIPage {
  async login(username: string, password: string): Promise<void> {
    await this.page.fill('#username', username);  // ❌ Direct locator
    await this.page.click('#loginBtn');  // ❌ Direct interaction
  }
}

// ✅ CORRECT - Page Object uses AIElement
export class LoginPage extends AIPage {
  private usernameInput: AIElement;
  private loginButton: AIElement;
  
    constructor(page: Page) {
        super(page, 'LoginPage');
        this.usernameInput = new AIElement(this, 'usernameInput', 'Username input field in the login form');
        this.loginButton = new AIElement(this, 'loginButton', 'Login submit button at the bottom of the form');
    }
  
  async login(username: string, password: string): Promise<void> {
    await TestLogger.pageStep('Fill login credentials', async () => {
      await this.usernameInput.fill(username);  // ✅ Via AIElement
      await this.loginButton.click();  // ✅ Via AIElement
    });
  }
}
```

