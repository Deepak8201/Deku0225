{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://git.netcracker.com/DEMO.SE.AI/nc-ai-workplace/-/raw/master/.cursor/skills/project-initialization/assets/analysis-report.schema.json",
  "title": "Initialization component analysis report",
  "description": "Structured facts a Phase 4 / Phase 5 / Phase 6 research subagent writes to .cursor/project/analysis/<component>.json. The companion <component>.md holds the human-readable narrative and is never read back by the orchestrator. Contract: .cursor/skills/project-initialization/references/subagent-contract.md",
  "type": "object",
  "required": [
    "schemaVersion",
    "component",
    "path",
    "kind",
    "coverage",
    "generatedAt",
    "businessModules",
    "entities",
    "endpointGroups",
    "integrations",
    "gaps"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "component": {
      "type": "string",
      "minLength": 1,
      "description": "Component name; also the artifact basename."
    },
    "path": {
      "type": "string",
      "description": "Repository-relative path analysed. '.' for a single-component repository."
    },
    "kind": {
      "type": "string",
      "enum": ["frontend", "backend", "mobile", "infra", "library", "mixed"]
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "coverage": {
      "type": "string",
      "enum": ["full", "partial"],
      "description": "'partial' whenever a budget was hit or an area could not be reached; gaps[] must then be non-empty."
    },
    "filesRead": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of files the subagent opened. Compared against the brief's budget."
    },
    "generatedAt": { "type": "string" },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "businessModules": {
      "type": "array",
      "description": "Named business areas. A generic name with no path is not a finding.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "entities": {
      "type": "array",
      "description": "Domain entities / aggregates / core types.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "relations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "endpointGroups": {
      "type": "array",
      "description": "Grouped, not flat: one entry per resource group.",
      "items": {
        "type": "object",
        "required": ["pathPattern"],
        "properties": {
          "pathPattern": { "type": "string", "minLength": 1 },
          "methods": { "type": "array", "items": { "type": "string" } },
          "count": { "type": "integer", "minimum": 0 },
          "version": { "type": "string" },
          "auth": { "type": "string" },
          "sourceFile": { "type": "string" }
        }
      }
    },
    "integrations": {
      "type": "array",
      "description": "Named external services / SDKs. Concrete package or endpoint names only.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "package": { "type": "string" },
          "usedIn": { "type": "array", "items": { "type": "string" } },
          "purpose": { "type": "string" },
          "complianceHint": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "patterns": {
      "type": "array",
      "description": "Recurring code patterns, each backed by evidence (a path or symbol).",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "description": "Populated for kind=infra components.",
      "properties": {
        "containers": { "type": "array", "items": { "type": "object" } },
        "orchestration": { "type": "array", "items": { "type": "object" } },
        "pipelines": { "type": "array", "items": { "type": "object" } },
        "environments": { "type": "array", "items": { "type": "string" } },
        "observability": { "type": "array", "items": { "type": "string" } }
      }
    },
    "crossComponentDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetPath": { "type": "string" },
          "via": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "What could not be determined, and why. Non-empty whenever coverage is 'partial'.",
      "items": { "type": "string" }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
