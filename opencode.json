{
  "$schema": "https://opencode.ai/config.json",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "vendor/**",
      "dist/**",
      "build/**",
      "out/**",
      "coverage/**",
      ".git/**",
      "logs/**",
      "tmp/**",
      "temp/**",
      ".cache/**",
      ".vscode/**",
      ".idea/**",
      ".taskmaster/tasks/**"
    ]
  },
  "permission": {
    "read": {}
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "environment": {}
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "mcp-atlassian": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-atlassian"
      ],
      "enabled": true,
      "environment": {
        "JIRA_URL": "<YOUR_JIRA_URL>",
        "JIRA_USERNAME": "<YOUR_JIRA_USERNAME>",
        "JIRA_API_TOKEN": "<YOUR_JIRA_API_TOKEN>",
        "CONFLUENCE_URL": "<YOUR_CONFLUENCE_URL>",
        "CONFLUENCE_USERNAME": "<YOUR_CONFLUENCE_USERNAME>",
        "CONFLUENCE_API_TOKEN": "<YOUR_CONFLUENCE_API_TOKEN>"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "atp-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@alexbuzo/atp-mcp@latest"
      ],
      "enabled": true,
      "environment": {
        "ATP_BASE_URL": "<atp-public-gateway-url>",
        "ATP_KEYCLOAK_URL": "<atp-keycloak-url>",
        "ATP_REALM": "atp2",
        "ATP_CLIENT_ID": "frontend",
        "ATP_USERNAME": "<your-atp-user>",
        "ATP_PASSWORD": "<your-atp-password>",
        "ATP_PROJECT_ID": "<atp-project-uuid>"
      }
    }
  }
}
