                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Successful POST request\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                                    "});",
                                    "var data = JSON.parse(responseBody);",
                                    "postman.setEnvironmentVariable(\"customerId\", data.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "url": {
                            "raw": "https://public-gateway-e2e-bss-qa3.saas-rnd-bss-qa-01.managed.netcracker.cloud/cim-tmf-service/customerManagement/v1/customer",
