        {
            "name": "create customer and billing account for B2B customer",
            "item": [
                {
                    "name": "2.1 Create individuals",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test(\"Successful POST request\", function () {",
                                    "    pm.expect(pm.response.code).to.be.oneOf([200,201]);",
                                    "});",
                                    "var data = JSON.parse(responseBody);",
                                    "pm.collectionVariables.set(\"engagedPartyId\", data.id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "url": {
                            "raw": "https://public-gateway-e2e-bss-qa3.saas-rnd-bss-qa-01.managed.netcracker.cloud/cim-tmf-service/partyManagement/v1/individual",
                            "protocol": "https",
                            "host": ["public-gateway-e2e-bss-qa3", "saas-rnd-bss-qa-01", "managed", "netcracker", "cloud"],
                            "path": ["cim-tmf-service", "partyManagement", "v1", "individual"]
                        },
                        "method": "POST",
                        "header": [
                            {"key": "Content-Type", "value": "application/json", "type": "default"},
                            {"key": "Authorization", "value": "Bearer {{token}}", "type": "default"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"contactMedium\": [{\"preferred\": false, \"type\": \"Telephone number\"}],\n    \"nationality\": \"US\",\n    \"familyName\": \"test\",\n    \"gender\": \"Male\",\n    \"givenName\": \"eca\"\n}"
                        }
                    }
                },
                {
                    "name": "2.2 Create customer_B2B",
                    "event": [
